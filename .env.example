# Copy to .env for local only — never commit real .env

# Server
METRIX_HOST=0.0.0.0
# Local default; Railway injects PORT automatically
METRIX_PORT=8787
# 0 = production (no debug reload, strict CORS)
METRIX_DEBUG=0

# Comma-separated browser origins allowed to call the API
# After Vercel deploy, set your exact *.vercel.app URL(s)
METRIX_CORS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Optional: force production mode label in logs/health
METRIX_ENV=production

# Public HTTPS URL of this API (Railway domain) — absolute pack links for browsers
# METRIX_PUBLIC_URL=https://metrix-ai-production.up.railway.app

# ── Supabase (persist live_log + sync all responses + skill_memory) ─────────
# SQL: docs/SUPABASE_FULL_SCHEMA.sql
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only — never in frontend
# SUPABASE_ANON_KEY=eyJ...           # optional client

# ── Security ────────────────────────────────────────────────────────────────
# METRIX_OPS_KEY=long-random-string   # X-Metrix-Ops-Key for robotics start / price
# METRIX_RATE_LIMIT=120
# METRIX_RATE_WINDOW_SEC=60
# METRIX_MAX_BODY_BYTES=524288

# ── Telegram (Karim bot · demo highway) ─────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBAPP_URL=https://metrix-ai.vercel.app/tg/
# TELEGRAM_PAYMENTS=0
